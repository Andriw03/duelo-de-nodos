{
  "appId": "cl.andres.nodostelar",
  "appName": "Duelo de Nodos",
  "webDir": "www",
  "backgroundColor": "#0e1322",
  "android": {
    "backgroundColor": "#0e1322"
  },
  "plugins": {
    "SystemBars": {
      "style": "DARK",
